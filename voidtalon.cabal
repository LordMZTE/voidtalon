cabal-version:       3.12

name:                voidtalon
version:             0.1.1.0
homepage:            https://git.mzte.de/LordMZTE/voidtalon
synopsis:            Lean TUI for OpenAI-compatible LLMs with MCP and tools.
license:             GPL-3.0-or-later
license-file:        LICENSE
author:              LordMZTE
maintainer:          lord@mzte.de
build-type:          Simple
extra-source-files:  README.md

executable vt
  other-modules:
      PackageInfo_voidtalon
      VoidTalon.CLI
      VoidTalon.Config
      VoidTalon.Config.Example
      VoidTalon.JSON
      VoidTalon.Log
      VoidTalon.Markdown
      VoidTalon.Net
      VoidTalon.Net.Completions
      VoidTalon.Net.MCP
      VoidTalon.Net.MCP.Types
      VoidTalon.Net.Models
      VoidTalon.Net.SSE
      VoidTalon.PromptLibrary
      VoidTalon.Tools
      VoidTalon.Tools.BuiltIn
      VoidTalon.Tools.BuiltIn.ReadFile
      VoidTalon.Tools.BuiltIn.RunCommand
      VoidTalon.Tools.BuiltIn.WriteFile
      VoidTalon.TUI
      VoidTalon.TUI.ConnectionSelector
      VoidTalon.TUI.Help
      VoidTalon.TUI.Markdown
      VoidTalon.TUI.ModelSelector
      VoidTalon.TUI.PromptLibrary
      VoidTalon.TUI.ReasoningEffort
      VoidTalon.TUI.Timeline
      VoidTalon.TUI.ToolManager
      VoidTalon.TUI.Types
      VoidTalon.Timeline
      VoidTalon.Util
  hs-source-dirs:      src
  main-is:             VoidTalon/Main.hs
  default-language:    Haskell2010
  build-depends:
      , aeson                 >= 2.2  && < 2.4
      , base                  >= 4.0  && < 4.23
      , brick                 >= 2.9  && < 2.14
      , bytestring            >= 0.12 && < 0.13
      , case-insensitive      >= 1.2  && < 1.3
      , commonmark            >= 0.2  && < 0.4
      , commonmark-extensions >= 0.2  && < 0.3
      , containers            >= 0.7  && < 0.9
      , directory             >= 1.3  && < 1.4
      , filepath              >= 1.5  && < 1.6
      , http-client           >= 0.7  && < 0.8
      , http-client-tls       >= 0.3  && < 0.5
      , http-types            >= 0.12 && < 0.13
      , microlens             >= 0.4  && < 0.6
      , microlens-mtl         >= 0.2  && < 0.3
      , microlens-th          >= 0.4  && < 0.5
      , network-uri           >= 2.6  && < 2.7
      , optparse-applicative  >= 0.18 && < 0.20
      , process               >= 1.6  && < 1.7
      , random                >= 1.2  && < 1.4
      , skylighting           >= 0.14 && < 0.16
      , text                  >= 2.1  && < 2.2
      , text-zipper           >= 0.13 && < 0.14
      , toml-parser           >= 2.0  && < 2.1
      , vector                >= 0.13 && < 0.14
      , vty                   >= 6.4  && < 6.7
      , mtl                   >= 2.3  && < 2.4
  ghc-options: -Wall
               -Wcompat
               -Widentities
               -Wincomplete-record-updates
               -Wincomplete-uni-patterns
               -Wincomplete-patterns
               -Wmissing-export-lists
               -Wmissing-home-modules
               -Wredundant-constraints

               -main-is VoidTalon.Main

               -- Needed for Brick
               -threaded
  default-extensions:
    OverloadedRecordDot
    NamedFieldPuns
    NoFieldSelectors
    DuplicateRecordFields

source-repository head
  type:     git
  location: https://git.mzte.de/LordMZTE/voidtalon
